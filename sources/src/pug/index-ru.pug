            .block__item
                .block__left
                    p.block__subtitle RS School
                    p.block__additional Март 2021 - Сентябрь 2021
                .block__right
                    .block__name JavaScript / Frontend

            .block__item
                .block__left
                    p.block__subtitle БГУИР
                    p.block__additional 2004 - 2010
                .block__right
                    .block__name Техническое обеспечение безопасности

