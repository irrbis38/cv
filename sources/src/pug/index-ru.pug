extends base/_layout
block vars
    - var lang = 'ru'
block head
    title Василий Илюхин - Резюме
block page

    section.about
        .container
            h2.about__title.title#about Обо мне
            p.about__text.
                Мне 42 года. Живу в Бобруйске, Беларусь.#[br]
                Коммерческий опыт работы - с октября 2020 года. Frontend-разработчик с техническим образованием.#[br]
                Актуальный стек: Vue, JS, TS, SCSS.#[br]


    section.experience.block#experience
        .container
            h2.block__title.title Опыт работы

            .block__item
                .block__left
                    p.block__subtitle Maxbitsolution
                    p.block__additional Ноябрь 2024 - настоящее время
                    p.block__additional Минск, Беларусь, удалённо

                .block__right
                    p.block__name Frontend-разработчик
                    p.block__about.
                        Работа в продуктовой компании:

                        - поддержка и развитие проекта.#[br]
                        - разработка новых фич.#[br]
                        - устраненние багов.#[br]
                        - проведение код-ревью.#[br]
                        - миграция логики с Vue 2 на Vue 3.#[br]
                        - покрытие тестами кодовой базы.#[br]
                        Стек: Vue, JS, TS, Pinia, Vue Test Utils + Jest, Gitlab


            .block__item
                .block__left
                    p.block__subtitle Art6
                    p.block__additional Сентябрь 2023 - Ноябрь 2024
                    p.block__additional Краснодар, Россия, удалённо, Part-time

                .block__right
                    p.block__name Frontend-разработчик
                    p.block__about.
                        Создание промо-сайтов, корпоративных порталов, интернет-магазинов, вёрстка email-рассылок, интеграция вёрстки на CMS Bitrix.#[br]
                        Поддержка уже существующих проектов.#[br]
                        Стек: Pug, JS, SCSS, GSAP, Github


            .block__item
                .block__left
                    p.block__subtitle PHPDev
                    p.block__additional Октябрь 2023 - Июнь 2024
                    p.block__additional Минск, Беларусь, удалённо, Part-time

                .block__right
                    p.block__name Frontend-разработчик
                    p.block__about.
                        Создание различных корпоративных порталов для крупных международных компаний.#[br]
                        Развитие и поддержа уже существующих проектов.#[br]
                        Стек: Pug, Nunjucks, JS, SCSS, GSAP, CMS Bitrix, Gitlab


            .block__item
                .block__left
                    p.block__subtitle LiveHTML
                    p.block__additional Октябрь 2022 - Сентябрь 2023
                    p.block__additional Минск, Беларусь, удалённо, Full-time

                .block__right
                    p.block__name Frontend-разработчик
                    p.block__about.
                        Создание интернет-порталов, корпоративных сайтов, event-площадок для Российских и Американских компаний с реализацией сложной анимации.#[br]
                        Стек: Pug, JS, SCSS, GSAP, Github

            .block__item
                .block__left
                    p.block__subtitle CreativeSolutions
                    p.block__additional Декабрь 2021 - Октябрь 2022
                    p.block__additional Минск, Беларусь, удалённо, Full-time

                .block__right
                    p.block__name Frontend-разработчик
                    p.block__about Создание сайтов различной степени сложости. Стек: Pug, JS, SCSS, Tailwind, React, Gitlab


            .block__item
                .block__left
                    p.block__subtitle Webfocus
                    p.block__additional Октябрь 2020 - Декабрь 2021
                    p.block__additional Минск, Беларусь, удалённо, Full-time

                .block__right
                    p.block__name Frontend-разработчик
                    p.block__about Создание различных сайтов, добавление интерактивных элементов, интеграция готовой вёрстки на CMS Wordpress.

    section.skills.block#skills
        .container
            h2.block__title.title Навыки и инструменты

            .block__item
            .block__right
                p.block__name Технические навыки
                ul.block__list
                    li HTML5, Pug
                    li CSS3, SCSS
                    li JavaScript, Typescript
                    li Vue, Pinia
                    li Vue Test Utils + Jest
                    li GSAP

            .block__item
            .block__right
                p.block__name Уровень английского
                ul.block__list
                    li B1

            .block__item
            .block__right
                p.block__name Инструменты
                ul.block__list
                    li Gitlab
                    li GitHub
                    li VS Code
                    li Figma
                    li Gulp
                    li Webpack
                    li Vite

    section.education.block#education
